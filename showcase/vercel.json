{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "framework": null,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ./",
  "buildCommand": "npm run build:static",
  "outputDirectory": "dist/client",
  "cleanUrls": true
}
